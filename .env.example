# Servidor local: npm start
PORT=8080
BASE_URL=http://localhost:8080
DATA_DIR=./data

# Para Docker Compose com Caddy, informe o domínio público sem https://.
# DOMAIN=live.seudominio.com

# Deixe vazios para o servidor gerar e persistir esses segredos em DATA_DIR.
HOST_KEY=
ADMIN_PASSWORD=

# Regras de uso
MAX_MINUTES=60
DEFAULT_MINUTES=10
PROVISION_TIMEOUT_SEC=180
REQUIRE_ONLINE=1
REQUIRE_BRIDGE=1

# Rede WebRTC (TURN é opcional)
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Opcionais; comandos Xbox são executados no servidor.
XBOX_POWER_ON_CMD=
XBOX_POWER_OFF_CMD=
TRUST_PROXY=0
DEBUG=0

# Opcionais para a ponte de controle no PC do jogo.
# Em servidor remoto, use por exemplo: wss://live.seudominio.com/ws
BRIDGE_URL=
BRIDGE_PYTHON=
BRIDGE_DRY_RUN=0
# Canal local entre o /host (P2P) e a ponte; só escuta em 127.0.0.1. 0 desliga.
BRIDGE_LOCAL_PORT=8765
# Origens extras aceitas no canal local (por padrão, só o site de BRIDGE_URL).
BRIDGE_ALLOWED_ORIGINS=
